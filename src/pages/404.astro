---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="404" description="This page doesn’t exist.">
	<section class="not-found">
		<h1>Nothing here.</h1>
		<p>
			There’s nothing at this address. It may have moved, or it may never
			have existed.
		</p>
		<nav class="not-found-links" aria-label="Ways back">
			<a href="/">Home</a>
			<a href="/blog">Notes</a>
		</nav>
	</section>
</SiteLayout>

<style>
	.not-found {
		max-width: 38rem;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.8rem, 8vw, 4.75rem);
		font-weight: 610;
		letter-spacing: -0.06em;
		line-height: 0.98;
	}

	p {
		margin: 2rem 0 0;
		max-width: 30rem;
		color: var(--muted-foreground);
		font-size: clamp(1.05rem, 2vw, 1.2rem);
		line-height: 1.6;
		text-wrap: pretty;
	}

	.not-found-links {
		display: flex;
		gap: 1.5rem;
		margin-top: 2rem;
	}

	.not-found-links a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--accent-strong);
		font-size: 0.95rem;
		font-weight: 570;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
	}
</style>
