---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="About me" description="About Jay.">
	<section class="about">
		<h1>About me</h1>
		<p class="about-lede">Hi, I’m Jay. I like programming.</p>
	</section>

	<section class="colophon" aria-labelledby="colophon-label">
		<h2 class="section-label" id="colophon-label">About this site</h2>
		<p>
			Hand-rolled with <a href="https://astro.build">Astro</a> and set in
			Helvetica Neue. No trackers, no analytics — the only thing stored in
			your browser is which theme you picked.
		</p>
		<p>
			Notes have an <a href="/rss.xml">RSS feed</a> if you’d rather read
			them somewhere else.
		</p>
	</section>
</SiteLayout>

<style>
	.about,
	.colophon {
		max-width: 38rem;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.8rem, 8vw, 4.75rem);
		font-weight: 610;
		letter-spacing: -0.06em;
		line-height: 0.98;
	}

	.about-lede {
		margin: 2rem 0 0;
		color: var(--muted-foreground);
		font-size: clamp(1.05rem, 2vw, 1.2rem);
		text-wrap: pretty;
	}

	.colophon {
		margin-top: clamp(3rem, 6vw, 4rem);
	}

	.colophon p {
		margin: 0 0 1rem;
		max-width: 34rem;
		color: var(--muted-foreground);
		font-size: 0.98rem;
		line-height: 1.7;
		text-wrap: pretty;
	}

	.colophon p:last-child {
		margin-bottom: 0;
	}

	.colophon a {
		color: var(--accent-strong);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
	}
</style>
