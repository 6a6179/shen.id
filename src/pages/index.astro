---
const TITLE = 'shen.id';
const DESCRIPTION = 'Jay Shen';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<title>{TITLE}</title>
		<meta name="description" content={DESCRIPTION} />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#101011" media="(prefers-color-scheme: dark)" />
		<!-- no tab icon: the empty data URI also stops the default /favicon.ico request -->
		<link rel="icon" href="data:," />
		<link rel="canonical" href="https://shen.id" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://shen.id" />
		<meta property="og:title" content={TITLE} />
		<meta property="og:description" content={DESCRIPTION} />
		<meta property="og:image" content="https://shen.id/og.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content="https://shen.id/og.png" />
	</head>
	<body>
		<main>
			<h1>Jay Shen</h1>
			<nav aria-label="Links" data-nosnippet>
				<a href="https://github.com/6a6179" target="_blank" rel="noopener noreferrer">
					<span>GitHub</span>
					<svg class="out" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11l6-6M6 5h5v5" /></svg>
				</a>
				<button id="ipa-copy" type="button" title="Copy AltStore source URL">
					<span>IPA Repo</span>
					<svg class="copy" viewBox="0 0 16 16" aria-hidden="true">
						<rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />
						<path d="M10.5 5.5V4A1.5 1.5 0 0 0 9 2.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5" />
					</svg>
					<svg class="check" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" /></svg>
				</button>
				<button id="contact-open" type="button"><span>Contact</span></button>
				<span class="sr-only" id="ipa-status" role="status"></span>
			</nav>
		</main>

		<dialog id="contact" aria-labelledby="contact-title" data-nosnippet>
			<div class="sheet">
				<header>
					<h2 id="contact-title">Contact</h2>
					<button class="close" type="button" data-close aria-label="Close">
						<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg>
					</button>
				</header>
				<form id="contact-form">
					<label>
						<span>Name</span>
						<input name="name" autocomplete="name" maxlength="100" required autofocus />
					</label>
					<label>
						<span>Email</span>
						<input name="email" type="email" autocomplete="email" maxlength="254" required />
					</label>
					<label>
						<span>Message</span>
						<textarea name="message" maxlength="5000" required></textarea>
					</label>
					<div
						class="cf-turnstile"
						data-sitekey="0x4AAAAAADzncJEwqw9wYIHB"
						data-theme="auto"
						data-size="flexible"
						data-action="turnstile-spin-v1"
					></div>
					<div class="foot">
						<button class="send" type="submit">Send</button>
						<p id="form-status" role="status" aria-live="polite"></p>
					</div>
				</form>
			</div>
		</dialog>

		<script>
			const SUBMIT_URL = 'https://contact.shen.id';
			const IPA_URL = 'https://shen.id/repo.json';

			/* ---------------- IPA repo copy ---------------- */
			const ipaBtn = document.getElementById('ipa-copy');
			const ipaStatus = document.getElementById('ipa-status');
			let ipaTimer;
			ipaBtn.addEventListener('click', async () => {
				ipaStatus.textContent = '';
				try {
					await navigator.clipboard.writeText(IPA_URL);
					ipaBtn.classList.add('copied');
					requestAnimationFrame(() => (ipaStatus.textContent = 'Source URL copied to clipboard'));
					clearTimeout(ipaTimer);
					ipaTimer = setTimeout(() => ipaBtn.classList.remove('copied'), 1400);
				} catch {
					requestAnimationFrame(() => (ipaStatus.textContent = 'Could not copy — opening link instead'));
					window.open(IPA_URL, '_blank', 'noopener');
				}
			});

			/* ---------------- contact dialog ---------------- */
			const dialog = document.getElementById('contact');
			const openBtn = document.getElementById('contact-open');
			const form = document.getElementById('contact-form');
			const status = document.getElementById('form-status');
			const sendBtn = form.querySelector('button[type="submit"]');
			let turnstileLoaded = false;
			let submitGen = 0;

			openBtn.addEventListener('click', () => {
				dialog.showModal();
				if (!turnstileLoaded) {
					turnstileLoaded = true;
					const s = document.createElement('script');
					s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
					s.async = true;
					s.onerror = () => {
						turnstileLoaded = false;
						s.remove();
						status.textContent = 'Verification failed to load — check your connection and reopen.';
					};
					document.head.appendChild(s);
				}
			});

			/* dismiss on backdrop only when the press both starts and ends there,
			   so dragging a text selection out of a field doesn't close the form */
			let pressedBackdrop = false;
			dialog.addEventListener('pointerdown', (e) => (pressedBackdrop = e.target === dialog));
			dialog.addEventListener('click', (e) => {
				if (e.target.closest('[data-close]') || (e.target === dialog && pressedBackdrop)) dialog.close();
			});
			dialog.addEventListener('close', () => {
				submitGen++;
				status.textContent = '';
				sendBtn.disabled = false;
				/* Safari doesn't focus buttons on click, so native focus-return misses */
				openBtn.focus();
			});

			form.addEventListener('submit', async (event) => {
				event.preventDefault();
				const formData = new FormData(form);
				const token = formData.get('cf-turnstile-response');
				if (!token) {
					status.textContent = window.turnstile
						? 'Please complete the verification.'
						: 'Verification is still loading — one moment.';
					return;
				}
				const gen = ++submitGen;
				sendBtn.disabled = true;
				status.textContent = 'Sending…';
				try {
					const response = await fetch(SUBMIT_URL, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({
							name: formData.get('name'),
							email: formData.get('email'),
							message: formData.get('message'),
							token,
						}),
					});
					const result = await response.json().catch(() => ({}));
					if (gen !== submitGen) return;
					if (!response.ok || result.success !== true) {
						throw new Error(result.error || 'Message delivery is temporarily unavailable.');
					}
					form.reset();
					window.turnstile?.reset();
					status.textContent = 'Sent.';
				} catch (error) {
					if (gen !== submitGen) return;
					status.textContent =
						error instanceof Error ? error.message : 'Message delivery is temporarily unavailable.';
					window.turnstile?.reset();
				} finally {
					if (gen === submitGen) sendBtn.disabled = false;
				}
			});
		</script>

		<style is:global>
			:root {
				--bg: #fbfbfa;
				--text: #1c1c1a;
				--dim: #6e6e68;
				--line: #e3e3df;
				--accent: #8b5cf6;
				--sans: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue',
					sans-serif;
			}
			@media (prefers-color-scheme: dark) {
				:root {
					--bg: #101011;
					--text: #ececea;
					--dim: #8b8b86;
					--line: #29292b;
					--accent: #a78bfa;
				}
			}

			* {
				box-sizing: border-box;
			}

			body {
				margin: 0;
				min-height: 100dvh;
				display: grid;
				place-items: center;
				padding: max(24px, env(safe-area-inset-top)) max(24px, env(safe-area-inset-right))
					max(24px, env(safe-area-inset-bottom)) max(24px, env(safe-area-inset-left));
				background: var(--bg);
				color: var(--text);
				font-family: var(--sans);
				font-size: clamp(1rem, 0.95rem + 0.2vw, 1.0625rem);
				line-height: 1.6;
				-webkit-font-smoothing: antialiased;
				text-rendering: optimizeLegibility;
			}

			::selection {
				background: color-mix(in srgb, var(--accent) 28%, transparent);
			}

			:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 4px;
				border-radius: 4px;
			}

			svg {
				width: 1em;
				height: 1em;
				fill: none;
				stroke: currentColor;
				stroke-width: 1.5;
				stroke-linecap: round;
				stroke-linejoin: round;
			}

			.sr-only {
				position: absolute;
				width: 1px;
				height: 1px;
				overflow: hidden;
				clip: rect(0 0 0 0);
				white-space: nowrap;
			}

			/* ---------------- page ---------------- */
			main {
				width: fit-content;
				max-width: 100%;
				/* sit a touch above true center */
				padding-bottom: 8dvh;
			}

			h1,
			h2 {
				margin: 0;
				font-size: inherit;
				font-weight: 500;
				letter-spacing: -0.01em;
			}
			nav {
				display: flex;
				flex-wrap: wrap;
				gap: 0.25rem 1.25rem;
				margin-top: 0.75rem;
			}
			nav a,
			nav button {
				appearance: none;
				background: none;
				border: 0;
				padding: 0;
				margin: 0;
				font: inherit;
				color: inherit;
				cursor: pointer;
				display: inline-flex;
				align-items: center;
				gap: 0.3em;
				text-decoration: none;
			}
			nav span:not(.sr-only) {
				/* longhands: Safari drops the shorthand when it carries a thickness */
				text-decoration-line: underline;
				text-decoration-color: var(--line);
				text-decoration-thickness: 1px;
				text-underline-offset: 0.3em;
				transition: text-decoration-color 0.2s;
			}
			nav :is(a, button):hover span {
				text-decoration-color: currentColor;
			}
			nav svg {
				width: 0.85em;
				height: 0.85em;
				color: var(--dim);
				transition:
					color 0.2s,
					transform 0.2s;
			}
			nav :is(a, button):hover svg {
				color: inherit;
			}
			nav a:hover .out {
				transform: translate(1px, -1px);
			}
			nav .check,
			nav .copied .copy {
				display: none;
			}
			nav .copied .check {
				display: block;
				color: var(--accent);
			}

			@media (prefers-reduced-motion: no-preference) {
				main > * {
					animation: in 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
				}
				main > :nth-child(2) {
					animation-delay: 0.08s;
				}
			}
			@keyframes in {
				from {
					opacity: 0;
					transform: translateY(6px);
				}
			}

			/* ---------------- contact dialog ---------------- */
			dialog {
				width: min(26rem, calc(100% - 2rem));
				padding: 0;
				overflow: hidden;
				border: 1px solid var(--line);
				border-radius: 14px;
				background: var(--bg);
				color: var(--text);
				box-shadow: 0 24px 60px -24px rgb(0 0 0 / 0.3);
			}
			/* ::backdrop only inherits custom properties in newer engines */
			dialog::backdrop {
				background: rgb(251 251 250 / 0.7);
				backdrop-filter: blur(8px);
				-webkit-backdrop-filter: blur(8px);
			}
			@media (prefers-color-scheme: dark) {
				dialog::backdrop {
					background: rgb(16 16 17 / 0.7);
				}
			}
			@media (prefers-reduced-motion: no-preference) {
				dialog,
				dialog::backdrop {
					opacity: 0;
					transition:
						opacity 0.2s,
						transform 0.2s cubic-bezier(0.2, 0.7, 0.2, 1),
						overlay 0.2s allow-discrete,
						display 0.2s allow-discrete;
				}
				dialog {
					transform: translateY(8px);
				}
				dialog[open],
				dialog[open]::backdrop {
					opacity: 1;
					transform: none;
				}
				@starting-style {
					dialog[open],
					dialog[open]::backdrop {
						opacity: 0;
					}
					dialog[open] {
						transform: translateY(8px);
					}
				}
			}

			/* the sheet scrolls, not the dialog, so the panel stays reachable when
			   the on-screen keyboard shrinks the viewport */
			.sheet {
				max-height: calc(100dvh - 2rem);
				overflow-y: auto;
				padding: 1.25rem 1.5rem 1.5rem;
			}
			.sheet header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 1.25rem;
			}
			.close {
				appearance: none;
				background: none;
				border: 0;
				padding: 0.375rem;
				margin: -0.375rem;
				color: var(--dim);
				font-size: 1rem;
				line-height: 0;
				cursor: pointer;
				transition: color 0.2s;
			}
			.close:hover {
				color: var(--text);
			}

			#contact-form {
				display: grid;
				gap: 1rem;
			}
			#contact-form label {
				display: grid;
				gap: 0.375rem;
			}
			#contact-form label span {
				font-size: 0.8125rem;
				color: var(--dim);
			}
			#contact-form input,
			#contact-form textarea {
				width: 100%;
				padding: 0.625rem 0.75rem;
				background: transparent;
				border: 1px solid var(--line);
				border-radius: 8px;
				color: inherit;
				font: inherit;
				/* 16px keeps iOS from zooming the page on focus */
				font-size: 1rem;
				transition: border-color 0.15s;
			}
			#contact-form input:focus,
			#contact-form textarea:focus {
				outline: none;
				border-color: var(--dim);
			}
			#contact-form textarea {
				display: block;
				min-height: 7.5rem;
				resize: vertical;
			}
			.cf-turnstile {
				min-height: 65px;
			}
			.foot {
				display: flex;
				align-items: center;
				gap: 1rem;
			}
			.send {
				appearance: none;
				flex: none;
				border: 0;
				border-radius: 8px;
				padding: 0.5rem 1.125rem;
				background: var(--text);
				color: var(--bg);
				font: inherit;
				font-weight: 500;
				cursor: pointer;
				transition: opacity 0.15s;
			}
			.send:hover {
				opacity: 0.85;
			}
			.send:disabled {
				opacity: 0.5;
				cursor: wait;
			}
			#form-status {
				margin: 0;
				font-size: 0.8125rem;
				line-height: 1.4;
				color: var(--dim);
			}

			@media (max-width: 400px) {
				dialog {
					width: calc(100% - 1.5rem);
				}
				.sheet {
					padding: 1rem;
				}
			}
		</style>
	</body>
</html>
